<?xml version="1.0" encoding="utf-8"?>
<!-- Icono de la pantalla Home: cruz médica dentro de un círculo.
     Es un vector drawable: se describe con trazos (paths), así se ve nítido a cualquier tamaño.
     Los colores vienen de colors.xml (prefijo home_). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Círculo de fondo -->
    <path
        android:fillColor="@color/home_primary"
        android:pathData="M12,2C6.48,2 2,6.48 2,12s4.48,10 10,10 10,-4.48 10,-10S17.52,2 12,2z" />

    <!-- Cruz médica -->
    <path
        android:fillColor="@color/home_on_primary"
        android:pathData="M10,6h4v4h4v4h-4v4h-4v-4H6v-4h4z" />
</vector>
